; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Sabor sang Panahon"
run/main_scene="res://game/ui/menus/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
run/max_fps=60
config/icon="res://icon.svg"

[autoload]

GameState="*res://core/autoload/game_state.gd"
PhantomCameraManager="*res://addons/phantom_camera/scripts/managers/phantom_camera_manager.gd"
SettingsManager="*res://core/autoload/settings_manager.gd"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/custom_font="res://assets/fonts/VCR_OSD_MONO_1.001.ttf"

