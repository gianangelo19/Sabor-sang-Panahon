[node name="npc_isatu_student_male_01" type="Node3D"]
editor_description = "Four-angle billboard NPC wearing a white blouse, black slacks, and an ISAT U-inspired student lanyard."
script = ExtResource("6_dialogue")
npc_display_name = "ISAT-U Student"
first_exchange = Array[String](["ISAT-U Student|I came to measure the old structures. The street added three distractions and one snack.", "Jobert|That sounds like accurate fieldwork.", "ISAT-U Student|My drawing is accurate. My schedule is fiction.", "Jobert|I am reconstructing a dish from people's memories.", "ISAT-U Student|Same principle. One person remembers the shape, another the material, someone else where it used to stand.", "Jobert|And eventually the whole thing appears?", "ISAT-U Student|If the measurements agree. If not, call it a concept study."])
repeat_exchange = Array[String](["ISAT-U Student|The building leaned before I drew it. Please note that."])
restored_exchange = Array[String](["ISAT-U Student|The old batchoyan was the missing structure. The neighborhood makes more sense with it named.", "Jobert|You added it to the drawing?", "ISAT-U Student|And a bowl for scale. Academic necessity."])

