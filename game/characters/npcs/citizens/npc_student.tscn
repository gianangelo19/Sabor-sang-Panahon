[node name="npc_student" type="Node3D" unique_id=1142351024]
script = ExtResource("6_dialogue")
npc_display_name = "College Student"
opening_line = "If my professor asks, I am conducting field research."
player_reply = "Into what?"
closing_line = "How long a student can avoid opening one PDF. Results are promising."
repeat_lines = Array[String](["The deadline is tomorrow, which is technically not today. I see no emergency.", "I bought coffee to study. Now I am too caffeinated to read and too responsible to sleep."])
restored_line = "So it was La Paz Batchoy. Finally, local history I can study with a spoon."
first_exchange = Array[String](["College Student|If my professor asks, I am conducting field research.", "Jobert|Into what?", "College Student|How long a student can avoid opening one PDF. Results may astound you."])
