script = ExtResource("6_dialogue")
npc_display_name = "San Ag Student"
opening_line = "My friends said, 'one quick stop.' That was forty minutes and three snacks ago."
player_reply = "You sound upset."
closing_line = "I am carrying snacks. I will recover."
repeat_lines = Array[String](["Never trust a friend who says 'last stop' while looking at a menu.", "I came here for notes. I am leaving with banana cue and no notes."])
restored_line = "La Paz Batchoy? Add one more stop. I have learned nothing and regret nothing."

