editor_description = "Four-angle billboard traffic enforcer NPC in an original blue-and-red uniform, directing traffic with a raised hand and baton."
script = ExtResource("6_dialogue")
npc_display_name = "Traffic Enforcer"
first_exchange = Array[String](["Traffic Enforcer|Ngaa ari ka di sa tunga dalan?", "Jobert|I need hel-", "Traffic Enforcer|I said why are you in the middle of the road?", "Jobert|I am asking around about a dish Lola Lynn forgot.", "Traffic Enforcer|Then ask later... Not when I'm in the middle of the road.", "Jobert|Fair."])
repeat_exchange = Array[String](["Traffic Enforcer|Cross when I signal, not when confidence arrives."])
restored_exchange = Array[String](["Traffic Enforcer|La Paz Batchoy. Good. The mystery is cleared; the intersection is not.", "Jobert|One problem at a time.", "Traffic Enforcer|That is what traffic says before rush hour."])

