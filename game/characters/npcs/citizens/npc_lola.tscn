[node name="npc_lola" type="Node3D" unique_id=1142351024]
script = ExtResource("6_dialogue")
npc_display_name = "Lola Nena"
opening_line = "Apo, you have your grandmother's worried eyebrows. Very expressive. Very bad at hiding plans."
player_reply = "I was hoping they looked mysterious."
closing_line = "No. Hungry, maybe. Eat something and try again."
repeat_lines = Array[String](["Your grandma and I used to trade recipes. Mostly we traded complaints about everyone else's recipes.", "Do not rush so much, apo. Even soup needs time before it becomes worth remembering."])
restored_line = "La Paz Batchoy. Ay, there you are. Some memories return through the tongue before the heart admits it missed them."
first_exchange = Array[String](["Lola Nena|Jobert, ari ka naman di?", "Lola Nena|You have Lola Lynn's worried eyebrows.", "Jobert|I was hoping they looked mysterious.", "Lola Nena|Gutom, maybe? You should eat first."])
repeat_exchange = Array[String](["Lola Nena|Indi magdali, apo. Even soup needs time."])
restored_exchange = Array[String](["Lola Nena|La Paz Batchoy. Amo gid na! The tongue remembered first."])

