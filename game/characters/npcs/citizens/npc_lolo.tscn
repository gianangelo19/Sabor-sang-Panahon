[node name="npc_lolo" type="Node3D" unique_id=1142351024]
script = ExtResource("6_dialogue")
npc_display_name = "Lolo Pilo"
opening_line = "Everyone walks too fast now. Then they arrive somewhere and stare at their phones. I can do that from a bench."
player_reply = "You're saving time."
closing_line = "And my knees. Wisdom comes in layers."
repeat_lines = Array[String](["This bench has heard more secrets than the barangay hall. It is also better at keeping them.", "When I was your age, we got lost without GPS. It built character and very tired feet."])
restored_line = "La Paz Batchoy... I remember arguing over the last spoonful. Good. I was worried I had become peaceful."
first_exchange = Array[String](["Lolo Pilo|Dugay ka na wala diri, toto Jobert.", "Lolo Pilo|Everyone walks too fast now. I can be late from a bench.", "Jobert|You are saving time.", "Lolo Pilo|And my knees."])
repeat_exchange = Array[String](["Lolo Pilo|When I was your age, we got lost without GPS. It built character and very tired feet."])
restored_exchange = Array[String](["Lolo Pilo|La Paz Batchoy... I remember arguing over the last spoonful."])

