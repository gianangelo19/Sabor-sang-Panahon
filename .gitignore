# Godot 4+ specific ignores
.godot/
/android/

# Downloaded source packages and editable source files. Keep extracted,
# game-ready assets instead.
*.zip
*.blend
*.blend1

# This asset pack uses `.blend` in a folder name; its exported textures are
# runtime dependencies and must remain versioned.
!assets/art/materials/old_linoleum_flooring_01_4k.blend/
!assets/art/materials/old_linoleum_flooring_01_4k.blend/textures/
!assets/art/materials/old_linoleum_flooring_01_4k.blend/textures/**

# Design/reference material is not required by the playable Godot project.
*.pdf
assets/art/images/Screenshot *.png
assets/art/images/Screenshot *.png.import

# Third-party demonstration scenes are not used by the game.
/addons/phantom_camera/examples/

# OS and editor clutter.
.DS_Store
Thumbs.db
desktop.ini
*.tmp
*.log
__pycache__/
*.pyc

# Local Godot exports and packaged releases.
/build/
/dist/
