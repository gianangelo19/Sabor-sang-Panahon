npc_display_name = "Campus Debater"
opening_line = "We are debating whether batchoy counts as breakfast, lunch, or emotional support."
player_reply = "What side are you on?"
closing_line = "Yes."
repeat_lines = Array[String](["A good debate changes minds. A good meal makes everyone stop talking. Higher success rate.", "My opponent brought citations. I brought an appetite. The judges remain divided."])
restored_line = "La Paz Batchoy settles the debate: breakfast, lunch, dinner, and emergency morale."

